# Copy this file to ~/skills/.env (mode 600) and fill in your own values.
# The .env is personal and is never committed.

# --- Git identity (used by scripts/git-init-context.sh and the /commit check) ---
# Your name and email exactly as they appear on your GitHub account.
GIT_NAME="<your name>"
GIT_EMAIL="<your email>"
# SSH key name in ~/.ssh/ (or a full path) for your GitHub account.
GIT_SSH_KEY="<key name>"
# Default GitHub owner for new remotes.
GIT_ORG="onlyfights420"

# --- /mr reviewers (optional; GitLab only) ---
# MR_CONTEXTS=<company>|<origin prefix>|<reviewer>[+<reviewer>...]
